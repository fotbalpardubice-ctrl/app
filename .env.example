# Local database file. The Node.js server creates the folder and tables automatically.
SQLITE_FILE=.data/ml-work.sqlite
PORT=4173
NODE_ENV=development
COOKIE_SECURE=1
PUBLIC_ORIGIN=https://localhost:4173
HTTPS_PFX_PATH=.certs/ml-work-localhost.pfx
HTTPS_PFX_PASSPHRASE=SET_A_LOCAL_RANDOM_PASSPHRASE

# Used only by `npm run db:create-admin`; saved as a scrypt hash in SQLite.
INITIAL_ADMIN_EMAIL=pmagusin@seznam.cz
INITIAL_ADMIN_NAME=Správce ML Work
INITIAL_ADMIN_PASSWORD=
